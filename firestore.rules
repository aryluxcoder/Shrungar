rules_version = '2';

// Who can read and write what in Firestore.
// Publish: Firebase console → Firestore Database → Rules → paste → Publish,
// or `npx firebase-tools deploy --only firestore:rules`.
// The shop team edits order and request status, review replies and chat replies from the
// Firebase console for now (the console is not limited by these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function createdByMe() {
      return isUser(request.resource.data.userId);
    }

    // Customer profiles: name and phone or email.
    match /users/{uid} {
      allow read, write: if isUser(uid);
    }

    // Customers place and see their own orders. Status changes come from the shop.
    match /orders/{orderId} {
      allow read: if isUser(resource.data.userId);
      allow create: if createdByMe() && request.resource.data.status == 'placed';
    }

    // Private nightwear & lingerie requests work the same way.
    match /requests/{requestId} {
      allow read: if isUser(resource.data.userId);
      allow create: if createdByMe() && request.resource.data.status == 'received';
    }

    // Reviews are public. Customers post their own and can mark any review helpful once.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if createdByMe()
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.helpfulBy == []
        && !('reply' in request.resource.data);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulBy'])
        && request.resource.data.helpfulBy.toSet().difference(resource.data.helpfulBy.toSet()).hasOnly([request.auth.uid])
        && resource.data.helpfulBy.toSet().difference(request.resource.data.helpfulBy.toSet()).hasOnly([request.auth.uid]);
      allow delete: if isUser(resource.data.userId);

      match /comments/{commentId} {
        allow create: if createdByMe();
        allow delete: if isUser(resource.data.userId);
      }
    }

    // Lets the app load all review comments in one query.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // Help chat: one private thread per customer. Shop replies are added by the shop team.
    match /chats/{uid}/messages/{messageId} {
      allow read: if isUser(uid);
      allow create: if isUser(uid) && request.resource.data.from in ['me', 'bot'];
    }
  }
}
